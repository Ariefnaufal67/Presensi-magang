# Salin file ini jadi ".env" untuk pengembangan lokal (vercel dev),
# lalu isi dengan connection string MongoDB Atlas kamu sendiri.
# JANGAN commit file ".env" ke git (sudah dikecualikan lewat .gitignore).

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Opsional — nama database, default "presensi_magang" kalau tidak diisi
MONGODB_DB=presensi_magang
