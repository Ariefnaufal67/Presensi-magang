# Salin file ini jadi .env lalu isi nilainya, untuk menjalankan server
# secara lokal (`npm start`). Di Render, environment variable ini diisi
# lewat dashboard (Settings -> Environment), bukan lewat file ini.

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=presensi_magang
PORT=3000
